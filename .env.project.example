# MentorFinder `/se-projects` deployment settings.
# Copy this file to .env on the server and protect it with chmod 600.
# Never commit .env or any real password/key.

# Platform contract
APP_ENTRY_ALIAS=mentorfinder-entry
PUBLIC_ORIGIN=https://lab.cs.tsinghua.edu.cn
PUBLIC_SITE_PATH=/se-projects/mentorfinder

# Project identity and container entry
PROJECT_NAME=MentorFinder
PROJECT_ID=mentorfinder
APP_UID_GID=10001:10001
APP_IMAGE=mentorfinder:2026.08.17
APP_PORT=8080
APP_HEALTH_PATH=/health

# Optional resource limits
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1g
APP_PIDS_LIMIT=256

# Required secrets: fill only in the server-side .env file.
JWT_SIGNING_KEY=
DJANGO_SECRET_KEY=

# Optional first administrator account. All three values are required together.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional SMTP configuration
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional OpenAI-compatible weekly-summary service
THUCS_API_BASE_URL=
THUCS_API_KEY=
THUCS_MODEL_NAME=deepseek-v4-flash

